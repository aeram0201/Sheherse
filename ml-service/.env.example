# SheherSe ML Service Environment Variables

# Service Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
SERVICE_NAME="SheherSe-Itinerary-Engine"
API_VERSION="v1"

# Google Maps Platform (Routes API)
# Set your server-restricted Google Maps API key with Routes API enabled
GOOGLE_MAPS_API_KEY=""

# Firebase Configuration
# Optional: Path to Firebase Service Account JSON file (do not commit actual JSON file)
FIREBASE_CREDENTIALS_PATH=""
# Optional: Set to 'True' to require valid Firebase ID tokens on protected endpoints
REQUIRE_FIREBASE_AUTH=False

# Planning Engine Configuration
DEFAULT_MAX_WALKING_KM=3.0
DEFAULT_BUFFER_MINUTES=15
SPEED_WALK_KMH=4.5
SPEED_TRANSIT_KMH=18.0
SPEED_DRIVE_KMH=22.0
MUMBAI_ROAD_DETOUR_FACTOR=1.35
