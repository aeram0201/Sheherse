<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    style="@style/SheherseCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvEnquiryTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@color/forest_green_pale"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/forest_green_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Tour: Forgotten South Mumbai" />

            <TextView
                android:id="@+id/tvEnquiryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                tools:text="14 Oct 2026" />
        </RelativeLayout>

        <!-- Sender info -->
        <TextView
            android:id="@+id/tvEnquirySender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="From: Sneha Roy (2 people)" />

        <TextView
            android:id="@+id/tvEnquiryContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/teal_secondary"
            android:textSize="13sp"
            tools:text="Contact: sneha.roy@email.com / +91 98765 43210" />

        <TextView
            android:id="@+id/tvEnquiryPreferred"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Preferred Date: This Saturday Morning" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvEnquiryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/warm_ivory_surface"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="“Hi Farhan! We are two architecture graduates visiting Mumbai for 3 days. Would love to join your Art Deco walk this Saturday!”" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
