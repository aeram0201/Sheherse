<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Blue sky above neoclassical Crescent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#60A5FA"
                android:centerColor="#93C5FD"
                android:endColor="#FAF8F2"
                android:angle="270" />
        </shape>
    </item>
    <!-- Colonnaded Neoclassical Crescent stone arcade buildings -->
    <item android:left="10dp" android:right="10dp" android:top="25dp" android:bottom="130dp">
        <shape android:shape="rectangle">
            <solid android:color="#FDF6E2" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Continuous covered arched pedestrian walkways (Arcades) -->
    <item android:left="25dp" android:right="285dp" android:top="60dp" android:bottom="130dp">
        <shape android:shape="rectangle"><solid android:color="#4E5D54" /><corners android:topLeftRadius="15dp" android:topRightRadius="15dp" /></shape>
    </item>
    <item android:left="85dp" android:right="225dp" android:top="60dp" android:bottom="130dp">
        <shape android:shape="rectangle"><solid android:color="#4E5D54" /><corners android:topLeftRadius="15dp" android:topRightRadius="15dp" /></shape>
    </item>
    <item android:left="145dp" android:right="165dp" android:top="60dp" android:bottom="130dp">
        <shape android:shape="rectangle"><solid android:color="#4E5D54" /><corners android:topLeftRadius="15dp" android:topRightRadius="15dp" /></shape>
    </item>
    <item android:left="205dp" android:right="105dp" android:top="60dp" android:bottom="130dp">
        <shape android:shape="rectangle"><solid android:color="#4E5D54" /><corners android:topLeftRadius="15dp" android:topRightRadius="15dp" /></shape>
    </item>
    <item android:left="265dp" android:right="45dp" android:top="60dp" android:bottom="130dp">
        <shape android:shape="rectangle"><solid android:color="#4E5D54" /><corners android:topLeftRadius="15dp" android:topRightRadius="15dp" /></shape>
    </item>
    <!-- Lush circular green central park with grand Banyan trees -->
    <item android:top="130dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2D6A4F"
                android:centerColor="#1B4332"
                android:endColor="#081C15"
                android:angle="270" />
        </shape>
    </item>
    <!-- Large leafy banyan tree canopy silhouette -->
    <item android:left="120dp" android:right="120dp" android:top="100dp" android:bottom="45dp">
        <shape android:shape="oval">
            <solid android:color="#40916C" />
        </shape>
    </item>
    <!-- Vintage Victorian cast iron garden bench -->
    <item android:left="135dp" android:right="135dp" android:top="165dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#081C15" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
