<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sunset Arabian Sea gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#D4AF37"
                android:centerColor="#E05A47"
                android:endColor="#081C15"
                android:angle="270" />
        </shape>
    </item>
    <!-- Arabian Sea waters with wave sheen -->
    <item android:top="110dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2D6A4F"
                android:centerColor="#1B4332"
                android:endColor="#081C15"
                android:angle="270" />
        </shape>
    </item>
    <!-- Sea waves lines -->
    <item android:left="30dp" android:right="30dp" android:top="135dp" android:bottom="90dp">
        <shape android:shape="rectangle">
            <solid android:color="#25FAF8F2" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:left="60dp" android:right="50dp" android:top="150dp" android:bottom="75dp">
        <shape android:shape="rectangle">
            <solid android:color="#18FAF8F2" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- The Queen's Necklace curved promenade wall -->
    <item android:top="170dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1B4332"
                android:endColor="#081C15"
                android:angle="0" />
        </shape>
    </item>
    <!-- Tetrapod rocks along promenade edge -->
    <item android:left="20dp" android:right="310dp" android:top="160dp" android:bottom="55dp">
        <shape android:shape="rectangle">
            <solid android:color="#081C15" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:left="45dp" android:right="285dp" android:top="155dp" android:bottom="60dp">
        <shape android:shape="rectangle">
            <solid android:color="#19201D" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="80dp" android:right="250dp" android:top="162dp" android:bottom="55dp">
        <shape android:shape="rectangle">
            <solid android:color="#081C15" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- Glowing street lamp posts (Queen's Necklace arc) -->
    <item android:left="30dp" android:right="320dp" android:top="148dp" android:bottom="78dp">
        <shape android:shape="oval">
            <solid android:color="#FFF3C4" />
        </shape>
    </item>
    <item android:left="90dp" android:right="260dp" android:top="152dp" android:bottom="74dp">
        <shape android:shape="oval">
            <solid android:color="#FFE885" />
        </shape>
    </item>
    <item android:left="160dp" android:right="190dp" android:top="155dp" android:bottom="71dp">
        <shape android:shape="oval">
            <solid android:color="#FFDF5C" />
        </shape>
    </item>
    <item android:left="230dp" android:right="120dp" android:top="158dp" android:bottom="68dp">
        <shape android:shape="oval">
            <solid android:color="#FFD633" />
        </shape>
    </item>
    <item android:left="300dp" android:right="50dp" android:top="160dp" android:bottom="66dp">
        <shape android:shape="oval">
            <solid android:color="#FFCD0A" />
        </shape>
    </item>
    <!-- Setting sun reflection glow -->
    <item android:left="140dp" android:right="140dp" android:top="50dp" android:bottom="130dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#80D4AF37"
                android:endColor="#00D4AF37"
                android:type="radial"
                android:gradientRadius="40dp" />
        </shape>
    </item>
</layer-list>
