<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep green gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#081C15"
                android:centerColor="#1B4332"
                android:endColor="#2D6A4F"
                android:angle="0" />
        </shape>
    </item>
    <!-- Route path background line -->
    <item
        android:left="20dp"
        android:right="20dp"
        android:top="108dp"
        android:bottom="108dp">
        <shape android:shape="rectangle">
            <solid android:color="#302D6A4F" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- Location pin 1 (start) -->
    <item
        android:left="40dp"
        android:right="280dp"
        android:top="90dp"
        android:bottom="90dp">
        <shape android:shape="oval">
            <solid android:color="#D4AF37" />
        </shape>
    </item>
    <!-- Location pin 2 (middle) -->
    <item
        android:left="155dp"
        android:right="165dp"
        android:top="90dp"
        android:bottom="90dp">
        <shape android:shape="oval">
            <solid android:color="#52B788" />
        </shape>
    </item>
    <!-- Location pin 3 (end) -->
    <item
        android:left="280dp"
        android:right="40dp"
        android:top="90dp"
        android:bottom="90dp">
        <shape android:shape="oval">
            <solid android:color="#D4AF37" />
        </shape>
    </item>
    <!-- Compass rose circles -->
    <item
        android:left="270dp"
        android:right="10dp"
        android:top="10dp"
        android:bottom="150dp">
        <shape android:shape="oval">
            <stroke android:color="#30D4AF37" android:width="1dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:left="285dp"
        android:right="25dp"
        android:top="25dp"
        android:bottom="165dp">
        <shape android:shape="oval">
            <stroke android:color="#20D4AF37" android:width="1dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Star/sparkle decorations -->
    <item
        android:left="10dp"
        android:right="330dp"
        android:top="30dp"
        android:bottom="180dp">
        <shape android:shape="oval">
            <solid android:color="#50D4AF37" />
        </shape>
    </item>
    <item
        android:left="80dp"
        android:right="260dp"
        android:top="10dp"
        android:bottom="200dp">
        <shape android:shape="oval">
            <solid android:color="#4052B788" />
        </shape>
    </item>
    <item
        android:left="200dp"
        android:right="140dp"
        android:top="150dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#40D4AF37" />
        </shape>
    </item>
</layer-list>
