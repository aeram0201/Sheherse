<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fort 1930s vintage Irani dining hall backdrop -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1E293B"
                android:centerColor="#334155"
                android:endColor="#0F172A"
                android:angle="270" />
        </shape>
    </item>
    <!-- Vintage green wainscoting / wooden booth wall -->
    <item android:bottom="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#14532D" />
        </shape>
    </item>
    <!-- Classic red & white checkered cafe tablecloth surface -->
    <item android:top="110dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#991B1B"
                android:centerColor="#B91C1C"
                android:endColor="#7F1D1D"
                android:angle="180" />
        </shape>
    </item>
    <!-- White porcelain serving plate -->
    <item android:left="60dp" android:right="60dp" android:top="60dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#F8FAFC" />
            <stroke android:color="#CBD5E1" android:width="3dp" />
        </shape>
    </item>
    <!-- Slow-cooked rich brown Parsi Sali Boti gravy -->
    <item android:left="80dp" android:right="80dp" android:top="75dp" android:bottom="35dp">
        <shape android:shape="oval">
            <solid android:color="#78350F" />
        </shape>
    </item>
    <!-- Mutton pieces nestled in curry -->
    <item android:left="110dp" android:right="110dp" android:top="85dp" android:bottom="55dp">
        <shape android:shape="oval">
            <solid android:color="#451A03" />
        </shape>
    </item>
    <!-- Heaping mound of crispy golden potato matchsticks (Sali) on top -->
    <item android:left="100dp" android:right="100dp" android:top="80dp" android:bottom="60dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FBBF24" />
            <stroke android:color="#D97706" android:width="2dp" />
        </shape>
    </item>
    <!-- Fresh crusty Brun Pav bun on the side -->
    <item android:left="25dp" android:right="210dp" android:top="115dp" android:bottom="15dp">
        <shape android:shape="oval">
            <solid android:color="#D97706" />
            <stroke android:color="#92400E" android:width="2dp" />
        </shape>
    </item>
</layer-list>
