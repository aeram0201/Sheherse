<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CST Station evening glow background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FAF8F2"
                android:centerColor="#FEF3C7"
                android:endColor="#9A3412"
                android:angle="270" />
        </shape>
    </item>
    <!-- CSMT Gothic facade silhouette across the road -->
    <item android:left="30dp" android:right="250dp" android:top="15dp" android:bottom="145dp">
        <shape android:shape="rectangle">
            <solid android:color="#2D6A4F" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
        </shape>
    </item>
    <item android:left="140dp" android:right="140dp" android:top="8dp" android:bottom="155dp">
        <shape android:shape="oval">
            <solid android:color="#1B4332" />
        </shape>
    </item>
    <!-- Giant round cast iron Tawa -->
    <item android:left="30dp" android:right="30dp" android:top="85dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#19201D" />
        </shape>
    </item>
    <!-- Piping hot red mashed spiced Pav Bhaji -->
    <item android:left="45dp" android:right="45dp" android:top="95dp" android:bottom="30dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#E05A47"
                android:centerColor="#DC2626"
                android:endColor="#B91C1C"
                android:angle="45" />
        </shape>
    </item>
    <!-- Giant melting yellow block of Amul butter floating in the center -->
    <item android:left="130dp" android:right="130dp" android:top="115dp" android:bottom="65dp">
        <shape android:shape="rectangle">
            <solid android:color="#FEF08A" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Melted golden butter pool around the block -->
    <item android:left="110dp" android:right="110dp" android:top="110dp" android:bottom="55dp">
        <shape android:shape="oval">
            <stroke android:color="#FBBF24" android:width="4dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Butter toasted ladi pav bun pairs on the side -->
    <item android:left="240dp" android:right="35dp" android:top="115dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#D4AF37" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
