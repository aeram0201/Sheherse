<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Purple to rose gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#EDE9FE"
                android:centerColor="#FCE7F3"
                android:endColor="#7C3AED"
                android:angle="270" />
        </shape>
    </item>
    <!-- Flower garland arch -->
    <item
        android:left="30dp"
        android:right="30dp"
        android:top="15dp"
        android:bottom="100dp">
        <shape android:shape="rectangle">
            <solid android:color="#307C3AED" />
            <corners android:topLeftRadius="100dp" android:topRightRadius="100dp" />
        </shape>
    </item>
    <!-- Inner arch -->
    <item
        android:left="50dp"
        android:right="50dp"
        android:top="30dp"
        android:bottom="100dp">
        <shape android:shape="rectangle">
            <solid android:color="#20DB2777" />
            <corners android:topLeftRadius="80dp" android:topRightRadius="80dp" />
        </shape>
    </item>
    <!-- Marigold clusters left -->
    <item
        android:left="40dp"
        android:right="270dp"
        android:top="25dp"
        android:bottom="150dp">
        <shape android:shape="oval">
            <solid android:color="#D97706" />
        </shape>
    </item>
    <item
        android:left="60dp"
        android:right="250dp"
        android:top="18dp"
        android:bottom="155dp">
        <shape android:shape="oval">
            <solid android:color="#D4AF37" />
        </shape>
    </item>
    <!-- Marigold clusters right -->
    <item
        android:left="270dp"
        android:right="40dp"
        android:top="25dp"
        android:bottom="150dp">
        <shape android:shape="oval">
            <solid android:color="#D97706" />
        </shape>
    </item>
    <item
        android:left="250dp"
        android:right="60dp"
        android:top="18dp"
        android:bottom="155dp">
        <shape android:shape="oval">
            <solid android:color="#D4AF37" />
        </shape>
    </item>
    <!-- Center flower cluster -->
    <item
        android:left="145dp"
        android:right="145dp"
        android:top="10dp"
        android:bottom="165dp">
        <shape android:shape="oval">
            <solid android:color="#E05A47" />
        </shape>
    </item>
    <!-- Flower market stalls -->
    <item
        android:left="20dp"
        android:right="200dp"
        android:top="120dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <solid android:color="#7C3AED" />
            <corners android:topLeftRadius="4dp" android:topRightRadius="4dp" />
        </shape>
    </item>
    <item
        android:left="170dp"
        android:right="50dp"
        android:top="115dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <solid android:color="#DB2777" />
            <corners android:topLeftRadius="4dp" android:topRightRadius="4dp" />
        </shape>
    </item>
    <!-- Ground path -->
    <item android:top="175dp">
        <shape android:shape="rectangle">
            <solid android:color="#402D6A4F" />
        </shape>
    </item>
</layer-list>
