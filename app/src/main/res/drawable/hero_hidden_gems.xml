<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep green to teal gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#081C15"
                android:centerColor="#1B4332"
                android:endColor="#2C6E63"
                android:angle="270" />
        </shape>
    </item>
    <!-- Step well descending steps -->
    <item
        android:left="40dp"
        android:right="40dp"
        android:top="60dp">
        <shape android:shape="rectangle">
            <solid android:color="#40916C" />
        </shape>
    </item>
    <item
        android:left="60dp"
        android:right="60dp"
        android:top="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#2D6A4F" />
        </shape>
    </item>
    <item
        android:left="80dp"
        android:right="80dp"
        android:top="100dp">
        <shape android:shape="rectangle">
            <solid android:color="#1B4332" />
        </shape>
    </item>
    <item
        android:left="100dp"
        android:right="100dp"
        android:top="120dp">
        <shape android:shape="rectangle">
            <solid android:color="#40916C" />
        </shape>
    </item>
    <item
        android:left="120dp"
        android:right="120dp"
        android:top="140dp">
        <shape android:shape="rectangle">
            <solid android:color="#2D6A4F" />
        </shape>
    </item>
    <!-- Water at the bottom -->
    <item
        android:left="120dp"
        android:right="120dp"
        android:top="160dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2052B788"
                android:endColor="#402C6E63"
                android:angle="270" />
        </shape>
    </item>
    <!-- Temple silhouette top left -->
    <item
        android:left="50dp"
        android:right="260dp"
        android:top="30dp"
        android:bottom="150dp">
        <shape android:shape="rectangle">
            <solid android:color="#081C15" />
            <corners android:topLeftRadius="3dp" android:topRightRadius="3dp" />
        </shape>
    </item>
    <!-- Temple spire -->
    <item
        android:left="55dp"
        android:right="270dp"
        android:top="15dp"
        android:bottom="170dp">
        <shape android:shape="rectangle">
            <solid android:color="#081C15" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp" />
        </shape>
    </item>
    <!-- Temple silhouette right -->
    <item
        android:left="260dp"
        android:right="50dp"
        android:top="35dp"
        android:bottom="150dp">
        <shape android:shape="rectangle">
            <solid android:color="#081C15" />
            <corners android:topLeftRadius="3dp" android:topRightRadius="3dp" />
        </shape>
    </item>
    <!-- Sparkle decorative dots -->
    <item
        android:left="160dp"
        android:right="160dp"
        android:top="20dp"
        android:bottom="180dp">
        <shape android:shape="oval">
            <solid android:color="#30D8F3DC" />
        </shape>
    </item>
</layer-list>
