<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sky gradient: gold sunset fading to deep green -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#D4AF37"
                android:centerColor="#E05A47"
                android:endColor="#081C15"
                android:angle="270" />
        </shape>
    </item>
    <!-- Sea horizon band -->
    <item android:top="140dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2C6E63"
                android:endColor="#081C15"
                android:angle="270" />
        </shape>
    </item>
    <!-- Warm glow circle (setting sun) -->
    <item
        android:left="130dp"
        android:right="130dp"
        android:top="40dp"
        android:bottom="120dp">
        <shape android:shape="oval">
            <solid android:color="#30D4AF37" />
        </shape>
    </item>
    <!-- Inner sun glow -->
    <item
        android:left="145dp"
        android:right="145dp"
        android:top="50dp"
        android:bottom="130dp">
        <shape android:shape="oval">
            <solid android:color="#50D4AF37" />
        </shape>
    </item>
    <!-- Gateway arch silhouette (simplified rectangular representation) -->
    <item
        android:left="110dp"
        android:right="110dp"
        android:top="60dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#081C15" />
            <corners android:topLeftRadius="40dp" android:topRightRadius="40dp" />
        </shape>
    </item>
    <!-- Gateway inner arch cutout -->
    <item
        android:left="130dp"
        android:right="130dp"
        android:top="80dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#30D4AF37" />
            <corners android:topLeftRadius="30dp" android:topRightRadius="30dp" />
        </shape>
    </item>
    <!-- Left tower -->
    <item
        android:left="100dp"
        android:right="230dp"
        android:top="50dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#081C15" />
            <corners android:topLeftRadius="4dp" android:topRightRadius="4dp" />
        </shape>
    </item>
    <!-- Right tower -->
    <item
        android:left="230dp"
        android:right="100dp"
        android:top="50dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#081C15" />
            <corners android:topLeftRadius="4dp" android:topRightRadius="4dp" />
        </shape>
    </item>
    <!-- Water ripple lines -->
    <item
        android:left="20dp"
        android:right="20dp"
        android:top="170dp"
        android:bottom="50dp">
        <shape android:shape="rectangle">
            <solid android:color="#152C6E63" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
